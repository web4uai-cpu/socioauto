# Copy to .env and fill in real values. Never commit the real .env file.
LLM_PROVIDER=openai
LLM_API_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
# Comma-separated account emails permitted to manage user roles.
ADMIN_EMAILS=admin@example.com
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/social_media_ai
REDIS_URL=redis://localhost:6379/0

# Base URL the OAuth providers redirect back to (must match your registered redirect URIs).
OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/accounts

# X / Twitter OAuth2 (authorization-code + PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=

# Meta (Facebook + Instagram) OAuth2
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKEN=

# LinkedIn OAuth2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok OAuth2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
