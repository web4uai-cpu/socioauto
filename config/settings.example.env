# Copy to .env and fill in real values. Never commit the real .env file.

# --- AI provider keys -------------------------------------------------------------
# One key per vendor, shared by every workload slot pointing at that vendor. Everything
# here is also settable from Admin -> AI Provider, which wins over these values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=

# --- One provider + model per job -------------------------------------------------
# Each agent runs on the slot matching its work, so a campaign can span several vendors.
# Set a provider to 'none' (or leave its key blank) to run that slot on deterministic
# fallbacks instead of an API. Blank model = the recommended model for that provider.
# Providers: anthropic | openai | google
AI_ANALYSIS_PROVIDER=anthropic
AI_ANALYSIS_MODEL=
AI_RESEARCH_PROVIDER=anthropic
AI_RESEARCH_MODEL=
AI_WRITING_PROVIDER=anthropic
AI_WRITING_MODEL=
# Image generation. Providers: openai
AI_IMAGE_PROVIDER=none
AI_IMAGE_MODEL=
# Voice (elevenlabs | openai) and video (google | runway | openai) are saved and handed to
# the agents, but nothing is generated yet — those agents still emit specs only.
AI_VOICE_PROVIDER=none
AI_VOICE_MODEL=
AI_VIDEO_PROVIDER=none
AI_VIDEO_MODEL=

# Your contracted rates. Leave blank and reports show exact token counts but no dollar
# figure — costs are never guessed. A run spanning several models is never priced.
LLM_COST_PER_MTOK_INPUT=
LLM_COST_PER_MTOK_OUTPUT=

# --- Legacy single-provider settings ----------------------------------------------
# Superseded by the slots above, still honoured as a fallback so an existing deployment
# keeps working untouched. Prefer the per-slot settings for anything new.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
# Comma-separated account emails permitted to manage user roles.
ADMIN_EMAILS=admin@example.com
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/social_media_ai
REDIS_URL=redis://localhost:6379/0

# Public base URL of the frontend, used to build Stripe Checkout return URLs.
APP_BASE_URL=http://localhost:5173

# Stripe. Leave STRIPE_SECRET_KEY blank to disable checkout (the API returns 503).
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint ("whsec_..."). Required to accept webhooks.
STRIPE_WEBHOOK_SECRET=
# Price ids for each paid tier.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=

# Base URL the OAuth providers redirect back to (must match your registered redirect URIs).
OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/accounts

# X / Twitter OAuth2 (authorization-code + PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=

# Meta (Facebook + Instagram) OAuth2
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKEN=

# LinkedIn OAuth2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok OAuth2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube + YouTube Shorts (one Google Cloud OAuth client covers both)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
